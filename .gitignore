# embed 16.8k chunks at build time. Regenerate them with build.sh.
data/*
!data/chunks.jsonl
!data/vectors.npy
indexes/
eval_results.json
quantization_meta.json

# ── Environment / secrets ───────────────────────────────
.env*
!.env.example

